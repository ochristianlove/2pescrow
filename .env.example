# Ethereum mainnet (ERC-20 USDT)
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ETHEREUM_CHAIN_ID=1

# Role-tagged wallets (replace with your addresses)
DEPLOYER_WALLET=0x0000000000000000000000000000000000000001
FEE_RECIPIENT_WALLET=0x0000000000000000000000000000000000000002
BUYER_WALLET=0x0000000000000000000000000000000000000003
SELLER_WALLET=0x0000000000000000000000000000000000000004
AGENT_WALLET=0x0000000000000000000000000000000000000005

# Official Ethereum ERC-20 USDC and USDT
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

ESCROW_FACTORY_ADDRESS=
INDEXER_START_BLOCK=0

# Tron (optional — platform toggle defaults OFF; configure before enabling in admin)
# The active example values below are for Shasta testing. After deploying the
# factory on Mainnet, replace them with the matching production settings:
# TRON_GRID_URL=https://api.trongrid.io
# TRON_WEB_RPC_URL=https://api.trongrid.io
# TRON_APP_NETWORK=Mainnet
# TRON_USDT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# TRON_ESCROW_FACTORY_ADDRESS=<new Mainnet factory address>
TRON_GRID_URL=https://api.shasta.trongrid.io
TRON_MAINNET_RPC_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_ESCROW_FACTORY_ADDRESS=
TRON_USDT_ADDRESS=
TRON_FEE_RECIPIENT_WALLET=
TRON_RESOLVER_WALLET=
TRON_APP_CHAIN_ID=728126428

DATABASE_URL=postgresql://twopescrow:twopescrow@localhost:5432/twopescrow
REDIS_URL=redis://localhost:6379
JWT_SECRET=generate-a-long-random-secret
ADMIN_API_KEY=generate-a-long-random-admin-key
INDEXER_API_KEY=generate-a-different-long-random-indexer-key
ADMIN_EMAIL=ochristianlove@gmail.com
ADMIN_PASSWORD=generate-a-strong-admin-password

# Optional: SMTP can be configured in Admin → Email delivery (stored in DB).
# Environment variables below override nothing unless set — prefer the admin UI.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# Public URL of the web app (magic links, referral links, verify URLs). Must match the URL you open in the browser.
# Same PC only: http://localhost:3003
# Phone on Wi‑Fi: http://YOUR_LAN_IP:3003 (use that URL on the PC too when testing email links)
WEB_ORIGIN=http://localhost:3003
UPLOAD_DIR=/data/uploads
RESOLUTION_MODE=admin
PORT=3000
WEB_PORT=3003
