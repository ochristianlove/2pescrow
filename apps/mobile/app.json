{
  "expo": {
    "name": "2Pescrow",
    "slug": "2pescrow",
    "version": "0.1.11",
    "backgroundColor": "#071018",
    "orientation": "portrait",
    "scheme": "twopescrow",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07140f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.twopescrow.app",
      "buildNumber": "14",
      "appleTeamId": "T4Y9L72F8B",
      "associatedDomains": [
        "applinks:2pescrow.com"
      ],
      "infoPlist": {
        "NSAllowsLocalNetworking": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "2Pescrow accesses your photo library so you can attach photos and videos as delivery proof or dispute evidence.",
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "rainbow",
          "safe"
        ]
      }
    },
    "android": {
      "package": "com.twopescrow.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 12,
      "backgroundColor": "#071018",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07140f"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "twopescrow"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "2pescrow.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./queries.js",
      "./plugins/withEmbeddedAndroidBundle.js",
      "./plugins/withIosDeploymentTarget.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3ecf8e",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://api.45.90.223.177.sslip.io",
      "webOrigin": "https://2pescrow.com",
      "privacyPolicyUrl": "https://2pescrow.com/privacy",
      "supportEmail": "support@2pescrow.com",
      "walletConnectProjectId": "99700e35ab779a3fdd3918084d55bd02",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "787dba3c-e58b-41d0-a25b-c6d72769a6aa"
      }
    },
    "owner": "ochris"
  }
}
